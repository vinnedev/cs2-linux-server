# CS2 Linux Server — template de variáveis de ambiente
# Copie para .env e preencha os valores sensíveis antes do primeiro boot.

# --- Rede / instância ---
PORT=27015
IP=0.0.0.0
TICKRATE=128
MAXPLAYERS=16
LAN=0

# Caminho opcional para o binário cs2 (útil em Windows / instalações existentes)
CS2_PATH=

# --- Tokens obrigatórios ---
# Steam Web API key:      https://steamcommunity.com/dev/apikey
# Steam Game Server GSLT: https://steamcommunity.com/dev/managegameservers
API_KEY=""
STEAM_ACCOUNT=""

# --- Segurança ---
SERVER_PASSWORD=""
RCON_PASSWORD="changeme"

# --- Execução ---
EXEC=retake.cfg

# --- Banco de dados (plugin Retakes VIP) ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
